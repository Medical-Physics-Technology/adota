# Copy to `.env` and adjust locally; `.env` is gitignored. Names and safe local
# defaults only -- never real credentials or production paths.
#
# Nothing here is required to run the unit suite; each variable has a working
# built-in default. They exist so the machine-specific paths and thread limits
# can be overridden without editing code.

# --- Golden (characterization) tests -----------------------------------------
# Where the reference CSVs for tests/golden/ live. Kept off the repository and
# off home storage, which is size-limited on the training machines.
ADOTA_GOLDEN_DIR=/scratch/mstryja/tmp_adota
# Set to any value to re-capture the goldens instead of comparing against them.
# Leave unset in normal use.
# ADOTA_GOLDEN_UPDATE=1

# --- External packages --------------------------------------------------------
# Checkout of the OpenTPS-side `datagenerator` repository, used only by the
# MCsquare byte-parity tests. They skip when it is absent.
ADOTA_DATAGENERATOR_ROOT=/home/mstryja/projects/datagenerator

# --- Threading ----------------------------------------------------------------
# Pinned to 1 by the scripts that fan gamma computation out across a process
# pool, so BLAS does not oversubscribe the cores. Override to profile.
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# --- Plotting -------------------------------------------------------------------
# Headless matplotlib backend; the analysis scripts set this themselves when unset.
MPLBACKEND=Agg
